# ==============================================================================
# SIPDIRA SPASIAL - BALAI WILAYAH SUNGAI KALIMANTAN I (KEMENTERIAN PEKERJAAN UMUM)
# Template Konfigurasi Environment Produksi & Deployment
# ==============================================================================

APP_NAME="SIPDIRA SPASIAL"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Konfigurasi Logging
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ==============================================================================
# KONFIGURASI DATABASE (MySQL / MariaDB / PostgreSQL / SQLite)
# Di PaaS (Railway / Render), variabel DB_URL / MYSQL_URL / DATABASE_URL terisi otomatis.
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sipdira_db
DB_USERNAME=root
DB_PASSWORD=

# Atau jika menggunakan PostgreSQL / Cloud URL:
# DB_URL=
# DATABASE_URL=

# Driver Session & Cache (Gunakan 'file' atau 'database' untuk container stateless)
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
FILESYSTEM_DISK=public

# Konfigurasi Email / Password Reset (Opsional)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="bwsk1pontianak@pu.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# Google reCAPTCHA v3 (Invisible)
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
RECAPTCHA_MIN_SCORE=0.5
